{
  "name": "sealql",
  "version": "1.1.1",
  "type": "module",
  "description": "Scoped encrypted fields and verified PostgreSQL search",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmp-develop/sealql.git"
  },
  "homepage": "https://github.com/jmp-develop/sealql#readme",
  "bugs": {
    "url": "https://github.com/jmp-develop/sealql/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "README_ko.md",
    "llms.txt",
    "examples",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./drizzle/v0.45": {
      "types": "./dist/adapters/drizzle/v0.45/index.d.ts",
      "import": "./dist/adapters/drizzle/v0.45/index.js",
      "require": "./dist/adapters/drizzle/v0.45/index.js",
      "default": "./dist/adapters/drizzle/v0.45/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc -p tsconfig.check.json --noEmit",
    "test:install": "node scripts/install-smoke.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "example:drizzle-v0.45": "node --import tsx scripts/run-drizzle-v0.45-example.ts"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.2 <0.46"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "esbuild": "^0.25.0",
    "miniflare": "^4.0.0",
    "pg": "8.23.0",
    "postgres": "3.4.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
