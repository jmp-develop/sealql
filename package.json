{
  "name": "sealql",
  "version": "0.1.0-experimental.0",
  "type": "module",
  "description": "Scoped encrypted fields and verified PostgreSQL search",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "llms.txt",
    "examples",
    "docs/llm-integration.md",
    "docs/current-state.md",
    "docs/threat-model.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drizzle/v0.45": {
      "types": "./dist/adapters/drizzle/v0.45/index.d.ts",
      "import": "./dist/adapters/drizzle/v0.45/index.js"
    },
    "./postgres": {
      "types": "./dist/adapters/postgres/sealed-index.d.ts",
      "import": "./dist/adapters/postgres/sealed-index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc -p tsconfig.check.json --noEmit",
    "test:install": "node scripts/install-smoke.mjs",
    "docs:check": "node scripts/docs-check.mjs"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.2 <0.46"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "esbuild": "^0.25.0",
    "miniflare": "^4.0.0",
    "pg": "8.23.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
